{
  "name": "vehicle-logic-lab",
  "private": true,
  "version": "0.6.0",
  "description": "A cozy vehicle logic and verification puzzle adventure",
  "author": "Vehicle Logic Lab",
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175 --strictPort",
    "build": "tsc --noEmit && tsc -p simulation/tsconfig.json && vite build",
    "preview": "vite preview --port 4175",
    "test": "node --test tests/*.test.mjs",
    "test:simulation": "node scripts/test-simulation.mjs",
    "test:game-ui": "node scripts/check-new-game-ui.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "desktop": "node scripts/open-game.mjs",
    "package:win": "npm run build && node scripts/package-win.mjs"
  },
  "build": {
    "appId": "studio.vehiclelogiclab.game",
    "productName": "Vehicle Logic Lab",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "package.json", "!node_modules/**/*"],
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "win": { "target": "portable", "icon": "desktop/app.ico", "signExecutable": false },
    "portable": { "artifactName": "Vehicle-Logic-Lab.exe" }
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@react-three/rapier": "^2.0.0",
    "@react-three/fiber": "^9.0.0",
    "pretendard": "^1.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@react-three/test-renderer": "9.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
